# npm run setup creates a private .env with a random initial password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Development: http://localhost:5173 ; Render production supports comma-separated origins:
# e.g. https://geriapharm.arshid.tech,https://geriapharm.onrender.com
APP_ORIGIN=http://localhost:5173
# Production (Render Managed PostgreSQL): set DATABASE_URL (takes precedence over DATABASE_PATH)
# DATABASE_URL=postgresql://user:password@host:5432/geriapharm
# Local development fallback (SQLite):
DATABASE_PATH=data/geriapharm.sqlite
COOKIE_SECURE=false
PORT=3001
# Trust proxy headers when running behind Render or a single reverse proxy:
TRUST_PROXY_HOPS=0
TRUST_LOOPBACK_PROXY=false
